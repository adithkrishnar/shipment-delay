# SupplyIQ Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Environment Mode: 'development' or 'production'
ENV=development
DEBUG=true

# Database Connection (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///supplyiq.db

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379

# JWT Authentication Secret
# NOTE: In production (ENV=production), SECRET_KEY MUST be explicitly set to
# a random cryptographically secure string of at least 32 characters.
SECRET_KEY=change-me-in-production-super-secret

# Token Expiry (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated or JSON list)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional External API Integrations (Application runs fully without these)
# Rotate these tokens periodically in production.
WEATHER_API_KEY=your_weather_api_key_here
NEWS_API_KEY=your_news_api_key_here
AI_API_KEY=your_ai_api_key_here
