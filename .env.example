# Copy this file to .env and fill in only what you actually have.
# The application runs completely fine with everything below left unset.

# Database - defaults to a local SQLite file if unset.
# Point this at a PostgreSQL URL to switch databases with no code changes:
# DATABASE_URL=postgresql://user:password@localhost:5432/supplyiq
DATABASE_URL=

ENV=development
DEBUG=true

# JWT Authentication
SECRET_KEY=change-me-in-production-super-secret

# Optional - only used if you wire up an LLM to explain recommendations.
# The recommendation engine has a fully local/deterministic fallback and
# does NOT require this key.
AI_API_KEY=

# Optional - only used for the live weather/news contextual risk layer.
# The app runs in OFFLINE/DEMO mode without these.
WEATHER_API_KEY=
NEWS_API_KEY=
